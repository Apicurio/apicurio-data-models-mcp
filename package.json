{
    "name": "@apitomy/data-models-mcp",
    "version": "1.2.1",
    "description": "MCP server wrapping @apitomy/data-models for AI-assisted OpenAPI and AsyncAPI editing",
    "type": "module",
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "bin": {
        "apitomy-data-models-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check src test",
        "lint:fix": "biome check --fix src test"
    },
    "keywords": [
        "mcp",
        "openapi",
        "asyncapi",
        "apitomy",
        "data-models"
    ],
    "license": "Apache-2.0",
    "dependencies": {
        "@apitomy/data-models": "3.1.3",
        "@modelcontextprotocol/sdk": "1.30.0",
        "js-yaml": "5.4.1",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@types/node": "24.13.4",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    }
}
